<file path="client/src/App.jsx">
import { BrowserRouter, Routes, Route, Navigate } from "react-router-dom";
import { useSelector } from "react-redux";
import Navbar from "./components/Navbar";
import ProtectedRoute from "./components/ProtectedRoute";
import LoginPage from "./pages/LoginPage";
import RegisterPage from "./pages/RegisterPage";
import FeedPage from "./pages/FeedPage";
import ProfilePage from "./pages/ProfilePage";

export default function App() {
  const token = useSelector((s) => s.auth.token);

  return (
    <BrowserRouter>
      {token && <Navbar />}
      <main className={token ? "main-with-nav" : ""}>
        <Routes>
          <Route path="/login" element={token ? <Navigate to="/" /> : <LoginPage />} />
          <Route path="/register" element={token ? <Navigate to="/" /> : <RegisterPage />} />
          <Route
            path="/"
            element={
              <ProtectedRoute>
                <FeedPage />
              </ProtectedRoute>
            }
          />
          <Route
            path="/explore"
            element={
              <ProtectedRoute>
                <FeedPage explore />
              </ProtectedRoute>
            }
          />
          <Route
            path="/profile/:id"
            element={
              <ProtectedRoute>
                <ProfilePage />
              </ProtectedRoute>
            }
          />
          <Route path="*" element={<Navigate to="/" />} />
        </Routes>
      </main>
    </BrowserRouter>
  );
}
</file>

<file path="client/src/index.css">
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg: #f0f2f5;
  --surface: #ffffff;
  --border: #dde0e4;
  --text: #1a1a1a;
  --text-muted: #60636a;
  --primary: #1877f2;
  --primary-hover: #145dbf;
  --danger: #e53935;
  --radius: 12px;
  --radius-sm: 8px;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 15px;
  line-height: 1.5;
  color: var(--text);
  background: var(--bg);
}

a { color: inherit; }

/* ── Navbar ────────────────────────────────────── */
.navbar {
  position: sticky; top: 0; z-index: 100;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
}
.navbar-inner {
  max-width: 680px; margin: 0 auto; padding: 0 16px;
  height: 56px; display: flex; align-items: center; gap: 16px;
}
.navbar-logo {
  font-weight: 800; font-size: 20px; text-decoration: none; color: var(--primary);
  margin-right: 8px;
}
.navbar-links { display: flex; gap: 16px; flex: 1; }
.navbar-links a {
  text-decoration: none; color: var(--text-muted); font-size: 15px; font-weight: 500;
  padding: 4px 8px; border-radius: 6px;
}
.navbar-links a:hover { color: var(--text); background: var(--bg); }

/* ── Layout ────────────────────────────────────── */
.main-with-nav { padding-top: 20px; }

/* ── Card ──────────────────────────────────────── */
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 16px;
}

/* ── Buttons ───────────────────────────────────── */
.btn-primary {
  background: var(--primary); color: #fff; border: none;
  padding: 8px 20px; border-radius: 20px; cursor: pointer;
  font-size: 14px; font-weight: 600; font-family: inherit;
  transition: background 0.15s;
}
.btn-primary:hover:not(:disabled) { background: var(--primary-hover); }
.btn-primary:disabled { opacity: 0.55; cursor: not-allowed; }
.btn-primary.full { width: 100%; padding: 12px; font-size: 15px; border-radius: var(--radius-sm); }
.btn-primary.sm { padding: 5px 14px; font-size: 13px; }
.btn-primary.outlined {
  background: transparent; color: var(--primary);
  border: 1.5px solid var(--primary);
}
.btn-primary.outlined:hover { background: #e8f0fd; }

.btn-ghost {
  background: none; border: none; cursor: pointer; color: var(--text-muted);
  padding: 6px 10px; border-radius: 20px; font-size: 14px; font-family: inherit;
}
.btn-ghost:hover { background: var(--bg); color: var(--text); }
.btn-ghost.liked { color: var(--danger); }

/* ── Inputs ────────────────────────────────────── */
input, textarea {
  width: 100%; padding: 10px 12px;
  border: 1px solid var(--border); border-radius: var(--radius-sm);
  font-size: 15px; font-family: inherit; color: var(--text);
  background: var(--surface); outline: none;
  transition: border-color 0.15s;
}
input:focus, textarea:focus { border-color: var(--primary); }
textarea { resize: vertical; min-height: 80px; }

/* ── Auth pages ────────────────────────────────── */
.auth-page {
  min-height: 100vh; display: flex; align-items: center;
  justify-content: center; background: var(--bg);
}
.auth-card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 36px 32px;
  width: 100%; max-width: 400px;
}
.auth-card h1 { font-size: 28px; color: var(--primary); margin-bottom: 2px; }
.auth-card h2 {
  color: var(--text-muted); font-size: 17px; font-weight: 400; margin-bottom: 24px;
}
.auth-card form { display: flex; flex-direction: column; gap: 12px; }
.auth-card p { margin-top: 18px; color: var(--text-muted); font-size: 14px; text-align: center; }
.auth-card a { color: var(--primary); text-decoration: none; font-weight: 600; }

/* ── Feed ──────────────────────────────────────── */
.feed-page { max-width: 640px; margin: 0 auto; padding: 0 16px 48px; }
.feed-container { display: flex; flex-direction: column; gap: 12px; }

/* ── Create Post ───────────────────────────────── */
.create-post textarea { margin-bottom: 10px; }
.create-post-footer { display: flex; align-items: center; gap: 10px; }
.file-label { color: var(--primary); cursor: pointer; font-size: 14px; font-weight: 500; }
.file-name {
  font-size: 13px; color: var(--text-muted); flex: 1;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.create-post-footer .btn-primary { margin-left: auto; }

/* ── Post Card ─────────────────────────────────── */
.post-header { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
.post-author {
  display: flex; align-items: center; gap: 8px;
  text-decoration: none; color: var(--text); flex: 1;
}
.post-author:hover .username { text-decoration: underline; }
.username { font-weight: 700; font-size: 14px; }
.post-date { font-size: 12px; color: var(--text-muted); }
.delete-btn { color: var(--text-muted); font-size: 13px; }
.post-content { font-size: 15px; line-height: 1.55; margin-bottom: 10px; }
.post-image {
  width: 100%; border-radius: var(--radius-sm); margin: 8px 0;
  max-height: 480px; object-fit: cover; display: block;
}
.post-actions {
  display: flex; gap: 4px;
  border-top: 1px solid var(--border); padding-top: 8px; margin-top: 8px;
}

/* ── Comments ──────────────────────────────────── */
.comments {
  border-top: 1px solid var(--border); padding-top: 10px;
  margin-top: 8px; display: flex; flex-direction: column; gap: 6px;
}
.comment { font-size: 14px; display: flex; gap: 6px; align-items: baseline; }
.comment-author {
  font-weight: 700; color: var(--text); text-decoration: none; white-space: nowrap;
}
.comment-author:hover { text-decoration: underline; }
.comment-form { display: flex; gap: 8px; margin-top: 4px; }
.comment-form input { flex: 1; padding: 7px 10px; font-size: 13px; }

/* ── Avatars ───────────────────────────────────── */
.avatar-sm { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
.avatar-lg { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
.avatar-placeholder {
  display: flex; align-items: center; justify-content: center;
  background: var(--primary); color: #fff; font-weight: 700; flex-shrink: 0;
}
.avatar-sm.avatar-placeholder { font-size: 15px; border-radius: 50%; }
.avatar-lg.avatar-placeholder { font-size: 30px; border-radius: 50%; }

/* ── Profile ───────────────────────────────────── */
.profile-page { max-width: 640px; margin: 0 auto; padding: 16px 16px 48px; }
.profile-header { display: flex; gap: 24px; align-items: flex-start; margin-bottom: 16px; }
.profile-info { flex: 1; }
.profile-info h2 { font-size: 22px; font-weight: 800; margin-bottom: 6px; }
.bio { color: var(--text-muted); font-size: 14px; margin-bottom: 12px; }
.profile-stats { display: flex; gap: 20px; font-size: 14px; margin-bottom: 14px; color: var(--text-muted); }
.profile-stats strong { color: var(--text); }
.edit-form textarea { margin-bottom: 8px; }
.edit-actions { display: flex; gap: 8px; }

/* ── Utilities ─────────────────────────────────── */
.error-msg {
  background: #fff0f0; border: 1px solid #ffc9c9;
  color: var(--danger); padding: 10px 14px;
  border-radius: var(--radius-sm); font-size: 14px;
}
.loading { text-align: center; padding: 48px; color: var(--text-muted); }
.empty-state { text-align: center; padding: 48px; color: var(--text-muted); font-size: 15px; }
